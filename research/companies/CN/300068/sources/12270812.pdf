</td><td rowspan="1" width="120" colspan="1">285</td><td rowspan="1" width="120" colspan="1">16.49%</td></tr><tr><td rowspan="1" width="120" colspan="1">40~50岁（含40岁）</td><td rowspan="1" width="120" colspan="1">107</td><td rowspan="1" width="120" colspan="1">94</td><td rowspan="1" width="120" colspan="1">13.83%</td></tr><tr><td rowspan="1" width="120" colspan="1">50岁以上</td><td rowspan="1" width="120" colspan="1">24</td><td rowspan="1" width="120" colspan="1">19</td><td rowspan="1" width="120" colspan="1">26.32%</td></tr></table></div><p>近三年公司研发投入金额及占营业收入的比例</p><div class="table-wrap"><table border="1"><tr><td rowspan="1" width="120" colspan="1"></td><td rowspan="1" width="120" colspan="1">2025年</td><td rowspan="1" width="120" colspan="1">2024年</td><td rowspan="1" width="120" colspan="1">2023年</td></tr><tr><td rowspan="1" width="120" colspan="1">研发投入金额（元）</td><td rowspan="1" width="120" colspan="1">497,105,977.56</td><td rowspan="1" width="120" colspan="1">449,911,452.09</td><td rowspan="1" width="120" colspan="1">476,603,226.05</td></tr><tr><td rowspan="1" width="120" colspan="1">研发投入占营业收入比例</td><td rowspan="1" width="120" colspan="1">6.65%</td><td rowspan="1" width="120" colspan="1">5.64%</td><td rowspan="1" width="120" colspan="1">3.25%</td></tr><tr><td rowspan="1" width="120" colspan="1">研发支出资本化的金额（元）</td><td rowspan="1" width="120" colspan="1">0.00</td><td rowspan="1" width="120" colspan="1">0.00</td><td rowspan="1" width="120" colspan="1">0.00</td></tr><tr><td rowspan="1" width="120" colspan="1">资本化研发支出占研发投入的比例</td><td rowspan="1" width="120" colspan="1">0.00%</td><td rowspan="1" width="120" colspan="1">0.00%</td><td rowspan="1" width="120" colspan="1">0.00%</td></tr><tr><td rowspan="1" width="120" colspan="1">资本化研发支出占当期净利润的比重</td><td rowspan="1" width="120" colspan="1">0.00%</td><td rowspan="1" width="120" colspan="1">0.00%</td><td rowspan="1" width="120" colspan="1">0.00%</td></tr></table></div><p>公司研发人员构成发生重大变化的原因及影响</p><p>□适用 ?不适用</p><p>研发投入总额占营业收入的比重较上年发生显著